# Copy to .env (here or in ~/.ai-usage-ledger/.env). Every line is optional.

# Anthropic Admin key from platform.claude.com/settings/admin-keys
ANTHROPIC_ADMIN_KEY=

# OpenAI Admin key from platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=

# Google Cloud Billing export table, as project.dataset.table
GOOGLE_BILLING_TABLE=
# Project to run the BigQuery query in (defaults to the table's project)
GOOGLE_PROJECT_ID=
# Optional: an OAuth access token; otherwise `gcloud auth print-access-token` is used
GOOGLE_ACCESS_TOKEN=

# Where local logs live, if not in the default place
# CLAUDE_CONFIG_DIR=
# CODEX_HOME=
# GEMINI_CLI_HOME=

# PORT=4317
# LEDGER_DAYS=90
